{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyNonTLSWrites",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${KOPS_OIDC_BUCKET}/*",
      "Condition": {"Bool": {"aws:SecureTransport": "false"}}
    },
    {
      "Sid": "PublicReadOfOidcDiscoveryDocumentsOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::${KOPS_OIDC_BUCKET}/${CLUSTER_NAME}/discovery/*"
      ]
    }
  ]
}
