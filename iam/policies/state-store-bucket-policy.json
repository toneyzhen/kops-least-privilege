{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyNonTLS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::${KOPS_STATE_BUCKET}", "arn:aws:s3:::${KOPS_STATE_BUCKET}/*"],
      "Condition": {"Bool": {"aws:SecureTransport": "false"}}
    },
    {
      "Sid": "DenyPutWithUnapprovedEncryptionHeader",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${KOPS_STATE_BUCKET}/*",
      "Condition": {
        "StringNotEquals": {"s3:x-amz-server-side-encryption": ["AES256", "aws:kms"]},
        "Null": {"s3:x-amz-server-side-encryption": "false"}
      }
    },
    {
      "Sid": "DenyKeyMaterialAndSecretsToEveryoneButKopsPrincipals",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": [
        "arn:aws:s3:::${KOPS_STATE_BUCKET}/*/pki/private/*",
        "arn:aws:s3:::${KOPS_STATE_BUCKET}/*/secrets/*"
      ],
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-kops-admin",
            "arn:aws:iam::${AWS_ACCOUNT_ID}:role/masters.${CLUSTER_NAME}"
          ]
        }
      }
    }
  ]
}
