{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAllowedPrefixObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${DEMO_DATA_BUCKET}/allowed/*"
    },
    {
      "Sid": "ListAllowedPrefixOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${DEMO_DATA_BUCKET}",
      "Condition": {"StringLike": {"s3:prefix": "allowed/*"}}
    }
  ]
}
