{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StateStoreBucketLevel",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions", "s3:GetBucketLocation", "s3:GetEncryptionConfiguration"],
      "Resource": "arn:aws:s3:::${KOPS_STATE_BUCKET}"
    },
    {
      "Sid": "StateStoreObjectsThisClusterOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": [
        "arn:aws:s3:::${KOPS_STATE_BUCKET}/${CLUSTER_NAME}",
        "arn:aws:s3:::${KOPS_STATE_BUCKET}/${CLUSTER_NAME}/*"
      ]
    },
    {
      "Sid": "OidcDiscoveryBucketLevel",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:GetBucketPolicy", "s3:GetBucketPolicyStatus"],
      "Resource": "arn:aws:s3:::${KOPS_OIDC_BUCKET}"
    },
    {
      "Sid": "OidcDiscoveryObjectsThisClusterOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectAcl", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::${KOPS_OIDC_BUCKET}/${CLUSTER_NAME}/discovery/*"
    },
    {
      "Sid": "ReadOnlyDescribeNoResourceLevelSupport",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "autoscaling:Describe*",
        "elasticloadbalancing:Describe*",
        "iam:ListRoles",
        "iam:ListInstanceProfiles",
        "iam:ListOpenIDConnectProviders",
        "sqs:ListQueues"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Ec2CreateInRegion",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc", "ec2:CreateSubnet", "ec2:CreateInternetGateway", "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup", "ec2:CreateDhcpOptions", "ec2:CreateNatGateway", "ec2:CreateVolume",
        "ec2:CreateLaunchTemplate", "ec2:AllocateAddress", "ec2:RunInstances"
      ],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "${AWS_REGION}"}}
    },
    {
      "Sid": "Ec2TagOnCreate",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {"aws:RequestedRegion": "${AWS_REGION}"},
        "Null": {"ec2:CreateAction": "false"}
      }
    },
    {
      "Sid": "Ec2MutateTaggedResourcesOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags", "ec2:DeleteTags",
        "ec2:ModifyVpcAttribute", "ec2:ModifySubnetAttribute", "ec2:ModifyInstanceAttribute",
        "ec2:AuthorizeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress", "ec2:RevokeSecurityGroupEgress",
        "ec2:AttachInternetGateway", "ec2:DetachInternetGateway",
        "ec2:AssociateRouteTable", "ec2:DisassociateRouteTable", "ec2:AssociateDhcpOptions",
        "ec2:CreateRoute", "ec2:DeleteRoute", "ec2:AttachVolume", "ec2:ModifyVolume",
        "ec2:CreateLaunchTemplateVersion", "ec2:ModifyLaunchTemplate", "ec2:DisassociateAddress"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${AWS_REGION}",
          "ec2:ResourceTag/KubernetesCluster": "${CLUSTER_NAME}"
        }
      }
    },
    {
      "Sid": "Ec2DestroyTaggedResourcesOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances", "ec2:DeleteVolume", "ec2:DetachVolume",
        "ec2:DeleteSecurityGroup", "ec2:DeleteSubnet", "ec2:DeleteVpc", "ec2:DeleteRouteTable",
        "ec2:DeleteInternetGateway", "ec2:DeleteDhcpOptions", "ec2:DeleteNatGateway",
        "ec2:DeleteLaunchTemplate", "ec2:ReleaseAddress"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${AWS_REGION}",
          "ec2:ResourceTag/KubernetesCluster": "${CLUSTER_NAME}"
        }
      }
    },
    {
      "Sid": "AutoScalingGroupsNamedForThisCluster",
      "Effect": "Allow",
      "Action": [
        "autoscaling:CreateAutoScalingGroup", "autoscaling:UpdateAutoScalingGroup",
        "autoscaling:DeleteAutoScalingGroup", "autoscaling:CreateOrUpdateTags", "autoscaling:DeleteTags",
        "autoscaling:PutLifecycleHook", "autoscaling:DeleteLifecycleHook",
        "autoscaling:AttachLoadBalancerTargetGroups", "autoscaling:DetachLoadBalancerTargetGroups",
        "autoscaling:SuspendProcesses", "autoscaling:ResumeProcesses",
        "autoscaling:SetDesiredCapacity", "autoscaling:TerminateInstanceInAutoScalingGroup",
        "autoscaling:EnableMetricsCollection", "autoscaling:PutWarmPool", "autoscaling:DeleteWarmPool"
      ],
      "Resource": "arn:aws:autoscaling:${AWS_REGION}:${AWS_ACCOUNT_ID}:autoScalingGroup:*:autoScalingGroupName/*.${CLUSTER_NAME}"
    },
    {
      "Sid": "LoadBalancersCreateTaggedForThisCluster",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:CreateLoadBalancer", "elasticloadbalancing:CreateTargetGroup",
        "elasticloadbalancing:CreateListener"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${AWS_REGION}",
          "aws:RequestTag/KubernetesCluster": "${CLUSTER_NAME}"
        }
      }
    },
    {
      "Sid": "LoadBalancersMutateTaggedForThisCluster",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:AddTags", "elasticloadbalancing:RemoveTags",
        "elasticloadbalancing:DeleteLoadBalancer", "elasticloadbalancing:DeleteTargetGroup",
        "elasticloadbalancing:DeleteListener", "elasticloadbalancing:ModifyLoadBalancerAttributes",
        "elasticloadbalancing:ModifyTargetGroup", "elasticloadbalancing:ModifyTargetGroupAttributes",
        "elasticloadbalancing:ModifyListener", "elasticloadbalancing:RegisterTargets",
        "elasticloadbalancing:DeregisterTargets", "elasticloadbalancing:SetSecurityGroups",
        "elasticloadbalancing:SetSubnets"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${AWS_REGION}",
          "aws:ResourceTag/KubernetesCluster": "${CLUSTER_NAME}"
        }
      }
    },
    {
      "Sid": "ServiceLinkedRolesForAsgAndElb",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/aws-service-role/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": ["autoscaling.amazonaws.com", "elasticloadbalancing.amazonaws.com"]
        }
      }
    },
    {
      "Sid": "IamRolesAndInstanceProfilesNamedForThisCluster",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:DeleteRole", "iam:GetRole", "iam:UpdateAssumeRolePolicy",
        "iam:TagRole", "iam:UntagRole",
        "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:GetRolePolicy",
        "iam:ListRolePolicies", "iam:ListAttachedRolePolicies", "iam:ListInstanceProfilesForRole",
        "iam:CreateInstanceProfile", "iam:DeleteInstanceProfile", "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile", "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile", "iam:UntagInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/*.${CLUSTER_NAME}",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:instance-profile/*.${CLUSTER_NAME}"
      ]
    },
    {
      "Sid": "AttachOnlyRepoManagedPoliciesToClusterRoles",
      "Effect": "Allow",
      "Action": ["iam:AttachRolePolicy", "iam:DetachRolePolicy"],
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/*.${CLUSTER_NAME}",
      "Condition": {
        "ArnLike": {"iam:PolicyARN": "arn:aws:iam::${AWS_ACCOUNT_ID}:policy/${NAME_PREFIX}-*"}
      }
    },
    {
      "Sid": "PassClusterRolesOnlyToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/*.${CLUSTER_NAME}",
      "Condition": {"StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}}
    },
    {
      "Sid": "OidcProviderForThisClusterIssuer",
      "Effect": "Allow",
      "Action": [
        "iam:CreateOpenIDConnectProvider", "iam:DeleteOpenIDConnectProvider", "iam:GetOpenIDConnectProvider",
        "iam:TagOpenIDConnectProvider", "iam:UntagOpenIDConnectProvider",
        "iam:UpdateOpenIDConnectProviderThumbprint", "iam:AddClientIDToOpenIDConnectProvider",
        "iam:RemoveClientIDFromOpenIDConnectProvider"
      ],
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:oidc-provider/${KOPS_OIDC_BUCKET}.s3.${AWS_REGION}.amazonaws.com/${CLUSTER_NAME}*"
    },
    {
      "Sid": "NodeTerminationHandlerQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue", "sqs:DeleteQueue", "sqs:GetQueueUrl", "sqs:GetQueueAttributes",
        "sqs:SetQueueAttributes", "sqs:TagQueue", "sqs:UntagQueue", "sqs:ListQueueTags"
      ],
      "Resource": [
        "arn:aws:sqs:${AWS_REGION}:${AWS_ACCOUNT_ID}:${CLUSTER_NAME_DASHED}-nth",
        "arn:aws:sqs:${AWS_REGION}:${AWS_ACCOUNT_ID}:${CLUSTER_NAME}-nth"
      ]
    },
    {
      "Sid": "NodeTerminationHandlerEventBridgeRules",
      "Effect": "Allow",
      "Action": [
        "events:PutRule", "events:DeleteRule", "events:DescribeRule", "events:PutTargets",
        "events:RemoveTargets", "events:ListTargetsByRule", "events:TagResource",
        "events:UntagResource", "events:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:events:${AWS_REGION}:${AWS_ACCOUNT_ID}:rule/${CLUSTER_NAME_DASHED}-*",
        "arn:aws:events:${AWS_REGION}:${AWS_ACCOUNT_ID}:rule/${CLUSTER_NAME}-*"
      ]
    },
    {
      "Sid": "DenyIdentityOrganizationAndAccountChanges",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser", "iam:DeleteUser", "iam:UpdateUser", "iam:CreateAccessKey", "iam:UpdateAccessKey",
        "iam:DeleteAccessKey", "iam:CreateLoginProfile", "iam:UpdateLoginProfile",
        "iam:AttachUserPolicy", "iam:PutUserPolicy", "iam:AddUserToGroup", "iam:CreateGroup",
        "iam:AttachGroupPolicy", "iam:PutGroupPolicy", "iam:CreatePolicy", "iam:CreatePolicyVersion",
        "iam:SetDefaultPolicyVersion", "iam:DeletePolicy", "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary", "iam:CreateSAMLProvider", "iam:UpdateAccountPasswordPolicy",
        "organizations:*", "account:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyTouchingThisReposPersonaRoles",
      "Effect": "Deny",
      "Action": [
        "iam:UpdateAssumeRolePolicy", "iam:PutRolePolicy", "iam:AttachRolePolicy", "iam:DetachRolePolicy",
        "iam:DeleteRolePolicy", "iam:DeleteRole", "iam:UpdateRole", "iam:TagRole", "iam:UntagRole"
      ],
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-*"
    },
    {
      "Sid": "DenyWeakeningStateStoreBucket",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketPolicy", "s3:DeleteBucketPolicy", "s3:PutBucketAcl", "s3:PutBucketPublicAccessBlock",
        "s3:PutEncryptionConfiguration", "s3:PutBucketOwnershipControls", "s3:DeleteBucket"
      ],
      "Resource": "arn:aws:s3:::${KOPS_STATE_BUCKET}"
    },
    {
      "Sid": "DenyPlaintextTransport",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": "*",
      "Condition": {"Bool": {"aws:SecureTransport": "false"}}
    }
  ]
}
