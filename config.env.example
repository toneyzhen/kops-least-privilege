# Copy to config.env and edit:  cp config.env.example config.env
# config.env is git-ignored. Every script sources it.

# --- AWS ---
export AWS_REGION="us-east-1"
export AWS_ACCOUNT_ID="123456789012"          # aws sts get-caller-identity --query Account --output text
export ZONES="${AWS_REGION}a"

# --- Naming ---
export NAME_PREFIX="lp-demo"
export CLUSTER_NAME="lp-demo.k8s.local"        # .k8s.local => gossip DNS, no Route53 needed

# --- Buckets (must be globally unique) ---
export KOPS_STATE_BUCKET="lp-demo-kops-state-${AWS_ACCOUNT_ID}"
export KOPS_STATE_STORE="s3://${KOPS_STATE_BUCKET}"
export KOPS_OIDC_BUCKET="lp-demo-kops-oidc-${AWS_ACCOUNT_ID}"   # public-read discovery docs for IRSA
export DEMO_DATA_BUCKET="lp-demo-data-${AWS_ACCOUNT_ID}"        # IRSA workload may read only allowed/*

# --- Cluster ---
export KUBERNETES_VERSION="1.33.5"
# Your public IP as /32 -- the only CIDR allowed to reach the Kubernetes API.
#   curl -s https://checkip.amazonaws.com
export ADMIN_CIDR="203.0.113.10/32"
